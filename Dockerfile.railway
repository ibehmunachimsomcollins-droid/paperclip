# Nexus — Railway deployment
FROM node:24-slim

RUN apt-get update && apt-get install -y \
    python3 make g++ git curl \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9

WORKDIR /app

COPY . .

# Install all dependencies including devDeps (needed for build)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Use turbo to build only the server and its deps (skips runner)
RUN pnpm exec turbo run build --filter=@paperclipai/server --no-daemon 2>&1 || true

# Verify the output exists
RUN ls server/dist/index.js || (echo "Build failed — dist not found" && exit 1)

EXPOSE 3100

ENV NODE_ENV=production
ENV PORT=3100
ENV PAPERCLIP_DISABLE_RUNNER=true

CMD ["node", "server/dist/index.js"]
