# Nexus — Railway deployment (tsx runtime, no build step, no cargo)
FROM node:24-slim

RUN apt-get update && apt-get install -y \
    python3 make g++ git \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9

WORKDIR /app

COPY . .

# Install deps, skip postinstall scripts (avoids cargo/copilot calls)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Install tsx globally to run TypeScript directly
RUN npm install -g tsx

EXPOSE 3100

ENV NODE_ENV=production
ENV PORT=3100
ENV PAPERCLIP_DISABLE_RUNNER=true
ENV PAPERCLIP_MIGRATION_AUTO_APPLY=true
ENV PAPERCLIP_MIGRATION_PROMPT=never

# Run server directly with tsx — no build step needed
CMD ["tsx", "server/src/index.ts"]
